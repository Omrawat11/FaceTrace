# ==============================================================================
# FaceTrace Environment Configuration Template
# Copy this file to .env and provide your credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Face Recognition Configuration
# ------------------------------------------------------------------------------
# Options: insightface, mock
FACE_DETECTOR_PROVIDER=insightface
# Minimum cosine similarity score (0.0 to 1.0) to qualify as a valid face match
FACE_SIMILARITY_THRESHOLD=0.45
# Face detection confidence threshold
FACE_DETECTION_CONFIDENCE=0.60

# ------------------------------------------------------------------------------
# Web / Social Search Provider Configuration
# ------------------------------------------------------------------------------
# Primary Search Provider options: serpapi, bing, mock
SEARCH_PROVIDER=serpapi

# SerpApi API Key (required if SEARCH_PROVIDER=serpapi)
# Get from: https://serpapi.com/
SERPAPI_API_KEY=

# Bing Visual Search Key (required if SEARCH_PROVIDER=bing)
# Get from: https://azure.microsoft.com/en-us/services/cognitive-services/bing-visual-search/
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/images/visualsearch

# Maximum candidate results to download and process per search query
MAX_SEARCH_RESULTS=10
SEARCH_REQUEST_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# Blockchain Configuration (Ethereum Sepolia Testnet)
# ------------------------------------------------------------------------------
# Options: sepolia, local, mock
BLOCKCHAIN_PROVIDER=mock

# Ethereum Sepolia RPC Endpoint (e.g., Alchemy, Infura, or public RPC)
# Example: https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Ethereum Private Key (hex with or without 0x prefix)
# Used only to sign transactions recording evidence fingerprints to Sepolia.
# IMPORTANT: Use a dedicated burner testnet wallet with zero mainnet funds!
ETH_PRIVATE_KEY=

# EvidenceRegistry Smart Contract Address on Sepolia
# Deployed contract address (0x...)
EVIDENCE_REGISTRY_CONTRACT_ADDRESS=

# Gas limit buffer multiplier
BLOCKCHAIN_GAS_LIMIT=200000

# ------------------------------------------------------------------------------
# Local Storage & Caching
# ------------------------------------------------------------------------------
DATA_DIR=data
DEMO_IMAGES_DIR=data/demo_images
CANDIDATES_CACHE_DIR=data/candidates
